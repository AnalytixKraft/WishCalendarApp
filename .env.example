# Copy to .env — or run `bash scripts/setup.sh`, which does that and fills in
# the three secrets for you. .env is never committed.

# Signing in to the app's pages. At least 8 characters; setup.sh makes one.
ADMIN_PASSWORD=

# Signs the sign-in cookie. At least 32 characters; setup.sh makes one.
# Changing it (or the password) signs everyone out.
SESSION_SECRET=

# Shared by the app and the WhatsApp bridge. At least 32 characters;
# setup.sh makes one. After changing it: docker compose up -d (not restart).
WHATSAPP_BRIDGE_TOKEN=

# The time zone the first run starts with. Change it later on the Settings page.
DEFAULT_TIMEZONE=Asia/Kolkata

# The app answers on http://localhost:<APP_PORT>, on this computer only.
APP_PORT=3210

# Optional: to reach the app from anywhere through a Cloudflare tunnel, paste
# the tunnel's token here and start with --profile tunnel. README.md, "Reach it
# from anywhere".
CLOUDFLARE_TUNNEL_TOKEN=
